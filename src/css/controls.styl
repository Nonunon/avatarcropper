// custom controls (dropdown, color picker, slider) that stand in for the native ones //

.dropdown
    position relative

    .dropdown-button
        display block
        width 100%
        height 100%
        margin 0
        padding 0 30px 0 10px
        border none
        background transparent
        color inherit
        font inherit
        line-height inherit
        text-align center
        white-space nowrap
        overflow hidden
        text-overflow ellipsis
        cursor pointer
        box-sizing border-box

        &:after
            content '▾'
            position absolute
            right 12px
            top 0
            bottom 0
            display flex
            align-items center
            font-size 14px
            color #949ba4
            transition transform 0.15s

    &.open .dropdown-button:after
        transform rotate(180deg)

    .dropdown-list
        position absolute
        top calc(100% + 4px)
        left 0
        right 0
        z-index 50
        margin 0
        padding 4px
        list-style none
        background #08090b
        border-radius 7px
        box-shadow 0 8px 24px rgba(0, 0, 0, 0.6), 0 0 0 1px #272d38
        max-height 280px
        overflow-y auto
        line-height normal
        text-align left
        text-align-last auto

    .dropdown-option
        padding 8px 10px
        border-radius 5px
        font-size 16px
        color #eee
        cursor pointer

        &:hover
            background #1c2129

        &.selected
            background #272d38
            color #ffc345

.colorPicker
    cursor pointer
    border none
    padding 0
    box-shadow inset 0 0 0 2px rgba(255, 255, 255, 0.15)

.colorPopover
    position fixed
    z-index 2000
    width 230px
    padding 10px
    box-sizing border-box
    display flex
    flex-direction column
    gap 10px
    background #12151a
    border-radius 8px
    box-shadow 0 10px 30px rgba(0, 0, 0, 0.7), 0 0 0 1px #272d38
    font-family Source Sans Pro, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif

    .colorPopover-area
        position relative
        height 140px
        border-radius 5px
        background-image linear-gradient(to top, #000, transparent), linear-gradient(to right, #fff, transparent)
        cursor crosshair
        touch-action none

    .colorPopover-hue
        position relative
        height 14px
        border-radius 7px
        background linear-gradient(to right, #f00, #ff0 17%, #0f0 33%, #0ff 50%, #00f 67%, #f0f 83%, #f00)
        cursor pointer
        touch-action none

        .colorPopover-thumb
            top 50%

    .colorPopover-thumb
        position absolute
        width 14px
        height 14px
        border-radius 50%
        border 2px solid #fff
        box-shadow 0 0 0 1px rgba(0, 0, 0, 0.6)
        transform translate(-50%, -50%)
        box-sizing border-box
        pointer-events none

    .colorPopover-swatches
        display grid
        grid-template-columns repeat(10, 1fr)
        gap 4px

    .colorPopover-swatch
        aspect-ratio 1
        padding 0
        border none
        border-radius 50%
        cursor pointer
        box-shadow inset 0 0 0 1px rgba(255, 255, 255, 0.15)

        &:hover
            transform scale(1.15)

    .colorPopover-hex
        background #08090b
        border none
        color #fff
        border-radius 5px
        padding 6px 8px
        font-family monospace
        font-size 14px

        &:focus
            outline 2px solid #ffc345

.labelSlider
    position relative
    cursor pointer
    touch-action none

    &:focus-visible
        outline 2px solid #ffc345

    .labelSlider-label
        width 100%
        height 100%
        pointer-events none

    .labelSlider-thumb
        position absolute
        top 50%
        width var(--thumb-size, 32px)
        height 32px
        border-radius 12px
        background #eeeeee
        opacity 0.5
        transform translateY(-50%)
        pointer-events none

.dialog-backdrop.gradientEdit
    .dropdown
        background-color #08090b
        border-radius 5px

        &:hover
            background-color #1c2129

        .dropdown-button
            padding 4px 30px 4px 8px

    .colorPicker.stopColor
        height 32px
        border-radius 5px
