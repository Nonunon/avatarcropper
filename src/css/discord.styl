// Discord profile preview //
.clipText
    -webkit-background-clip text
    background-clip text
    color transparent !important

@keyframes dpPrism
    0%
        background-position 0% 0

    100%
        background-position 200% 0

.discordPanel
    position absolute
    top 16px
    right 272px
    width 300px
    z-index 2
    background #111214
    border-radius 8px
    box-shadow 0 8px 24px rgba(0, 0, 0, 0.5)
    color #f2f3f5
    overflow hidden
    font-family 'Noto Sans', Source Sans Pro, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif

    .dpHeader
        display flex
        align-items center
        gap 6px
        padding 6px 8px
        background #08090b
        cursor move

        .dpTitle
            flex-grow 1
            font-size 14px
            font-weight 600
            color #ddd

    .dpButton
        cursor pointer
        background #1c2129
        color #eee
        border none
        border-radius 5px
        padding 4px 10px
        font-size 13px
        font-family inherit
        transition background 0.2s

        &:hover
            background #272d38

        &.dpClose
            padding 4px 8px

    .dpCard
        position relative
        background #232428
        padding 0 16px 16px 16px

        .dpBanner
            height 60px
            margin 0 -16px
            background linear-gradient(135deg, #ffc345, #eb459e)

        .dpAvatar
            margin-top -44px
            box-shadow 0 0 0 6px #232428
            border-radius 50%
            background #232428

    .dpAvatar
        position relative
        flex-shrink 0

        .preview
            position absolute
            left 0
            top 0
            overflow hidden
            border-radius 50%

            .bottomBar
                display none !important

            .previewCanvas
                display block

        .dpDecoration
            position absolute
            pointer-events none
            z-index 3

        .dpStatus
            position absolute
            right -2px
            bottom -2px
            box-sizing content-box
            border-radius 50%
            background #23a55a
            border-style solid
            border-color #232428
            z-index 4

    .dpName
        font-weight 600
        white-space nowrap
        overflow hidden
        text-overflow ellipsis

    .dpBigName
        margin-top 10px
        font-size 20px
        line-height 26px

    .dpUsername
        font-size 14px
        color #b5bac1

    .dpList
        background #2b2d31
        padding 12px 8px 10px 8px

        .dpListLabel
            font-size 11px
            font-weight 600
            letter-spacing 0.04em
            color #949ba4
            padding 0 8px 6px 8px

        .dpRow
            position relative
            display flex
            align-items center
            gap 12px
            height 42px
            padding 0 8px
            border-radius 4px
            overflow hidden

            &:hover
                background #35373c

            .dpPlate
                position absolute
                left 0
                top 0
                width 100%
                height 100%
                object-fit cover
                pointer-events none

            .dpAvatar, .dpSmallName
                position relative
                z-index 1

            .dpAvatar .dpStatus
                border-color #2b2d31

            .dpSmallName
                font-size 16px
                line-height 20px
                padding 2px 0

.dialog-backdrop.discordPicker
    .dialog
        width 720px

    h2
        margin 4px 0 12px 0

    .dpTabs
        display flex
        gap 6px
        margin-bottom 12px

    .dpTab, .dpChoice, .dpTile, .dpPlateTile, .dpSwatch
        cursor pointer
        border none
        font-family inherit
        color #eee
        background #08090b
        transition background 0.2s, box-shadow 0.2s

        &:hover
            background #1c2129

        &.toggled
            background #272d38
            box-shadow inset 0 0 0 2px #ffc345

    .dpTab
        flex-grow 1
        padding 10px
        border-radius 7px
        font-size 16px

    .dpBody
        text-align left

    .dpHint
        white-space pre-wrap
        color #b5bac1
        font-size 14px
        line-height 1.4

    .dpSearch, .dpText
        width 100%
        box-sizing border-box
        padding 8px
        margin-bottom 12px
        border-radius 5px
        border none
        background #08090b
        color white
        font-size 16px
        font-family inherit

        &:focus
            outline 2px solid #ffc345

    .dpGrid
        display grid
        grid-template-columns repeat(auto-fill, minmax(96px, 1fr))
        gap 8px

    .dpTile
        display flex
        flex-direction column
        align-items center
        justify-content center
        padding 8px 4px 6px 4px
        border-radius 7px
        min-height 104px
        min-width 0

        img
            width 72px
            height 72px
            pointer-events none

        &.dpNone
            font-size 16px

    .dpLabel
        display block
        max-width 100%
        margin-top 4px
        font-size 12px
        white-space nowrap
        overflow hidden
        text-overflow ellipsis
        color #b5bac1

    .dpPlateList
        display grid
        grid-template-columns repeat(auto-fill, minmax(200px, 1fr))
        gap 8px

    .dpPlateTile
        position relative
        height 48px
        border-radius 7px
        overflow hidden
        text-align left
        padding 0 10px

        img, video
            position absolute
            left 0
            top 0
            width 100%
            height 100%
            object-fit cover
            pointer-events none

        .dpLabel
            position relative
            margin 0
            color #fff
            font-size 14px
            text-shadow 0 1px 3px rgba(0, 0, 0, 0.9)

        &.dpNone
            text-align center
            font-size 16px

    .dpNamePreview
        background #2b2d31
        border-radius 7px
        padding 16px
        margin-bottom 12px
        text-align center
        font-size 26px
        line-height 34px

        .dpName
            font-weight 600

    .dpField
        display block

        span
            display block
            font-size 13px
            color #b5bac1
            margin-bottom 4px

    .dpSection
        font-size 13px
        font-weight 600
        color #b5bac1
        text-transform uppercase
        letter-spacing 0.04em
        margin 12px 0 6px 0

    .dpChoices
        display flex
        flex-wrap wrap
        gap 6px

    .dpChoice
        padding 8px 12px
        border-radius 7px
        font-size 16px

        .dpFontReal
            display block
            font-family Source Sans Pro, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif
            font-size 11px
            color #949ba4

    .dpSwatches
        display flex
        flex-wrap wrap
        gap 6px
        margin-bottom 8px

    .dpSwatch
        width 28px
        height 28px
        border-radius 50%
        box-shadow inset 0 0 0 1px rgba(255, 255, 255, 0.15)

        &:hover
            filter brightness(1.15)

        &.toggled
            box-shadow 0 0 0 2px #12151a, 0 0 0 4px #ffc345

    .dpHex
        width 120px
        font-family monospace

    .dpUsers
        display flex
        flex-direction column
        gap 8px

    .dpUser
        display flex
        align-items center
        gap 10px
        padding 8px
        background #08090b
        border-radius 7px

        .dpUserAvatar
            width 48px
            height 48px
            border-radius 50%

        .dpUserInfo
            flex-grow 1
            min-width 0

            .dpName
                font-size 18px
                font-weight 600

        .dpUserMeta
            font-size 13px
            color #b5bac1
            white-space nowrap
            overflow hidden
            text-overflow ellipsis

        .dpChoice
            background #1c2129

            &:hover
                background #272d38
