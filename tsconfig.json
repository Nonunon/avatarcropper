{
    "compilerOptions": {
        "noEmit": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "ES2020",
        "strict": false,
        "skipLibCheck": true,
        "allowJs": false,
        "lib": [
            "es2020",
            "dom",
            "dom.iterable"
        ],
        "types": [
            "vite/client"
        ]
    },
    "include": [
        "src/**/*.ts"
    ]
}
